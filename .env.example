NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public VAPID key for Web Push (browser notifications). Safe to expose
# client-side. Generate a pair with `npx web-push generate-vapid-keys` and
# set the matching private key + subject as Supabase Edge Function secrets
# (VAPID_PRIVATE_KEY, VAPID_SUBJECT) — never put the private key here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
